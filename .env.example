# SwapCheck Environment Configuration Template

# Database Connection (SQLite or PostgreSQL)
SWAPCHECK_DATABASE_URL=sqlite:///swapcheck.db

# LLM Response Caching
SWAPCHECK_CACHE_ENABLED=true
SWAPCHECK_CACHE_DB_PATH=.swapcheck_cache.db

# Statistical Engine Parameters
SWAPCHECK_DEFAULT_BOOTSTRAP_RESAMPLES=2000
SWAPCHECK_DEFAULT_OVERALL_MARGIN=0.05
SWAPCHECK_DEFAULT_CATEGORY_MARGIN=0.10
SWAPCHECK_MIN_SCENARIOS_OVERALL=50
SWAPCHECK_MIN_SCENARIOS_PER_CATEGORY=8
SWAPCHECK_DEFAULT_RUNS_PER_SCENARIO=3

# Logging Level (DEBUG, INFO, WARNING, ERROR)
SWAPCHECK_LOG_LEVEL=INFO

# Optional Provider API Keys (Used when evaluating real models via LiteLLM)
# MockProvider runs completely offline without any API keys.
# OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GEMINI_API_KEY=your-gemini-key-here

