# SwapCheck environment template.
#
# Only provider API keys are read from the environment, and only by the config files that
# name them through `api_key_env_var` (see configs/*.example.yaml). Everything else is a CLI
# flag: run `swapcheck run --help`. The offline mock configs need no keys at all.
#
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
